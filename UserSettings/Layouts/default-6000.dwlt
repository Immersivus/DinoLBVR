    }\n        },\n        {\n            \"m_GuidSerialized\": \"cdebf1be-4399-4b31-9ad4-8fb8bae01624\",\n           
    \"m_Title\": \"Blending Bubbles and Foam based on Ripple Amplitude\",\n           
    \"m_Position\": {\n                \"x\": 3263.99951171875,\n               
    \"y\": -103.0\n            }\n        }\n    ],\n    \"m_StickyNotes\": [\n       
    {\n            \"m_GuidSerialized\": \"627b4e57-2256-4671-9cea-90daa0390412\",\n           
    \"m_Title\": \"Set Either master Node Active\",\n            \"m_Content\": \"Unlit
    is better when you have no dynamic lights.\\n\\nAlpha Clip Values of < 0.5 are
    recommended. 0.1 works for most cases.\\n\\nMaster nodes should be set to Two-Sided
    and Opaque. If two sided is disabled, liquid top surface will not be visible.\\n\\n\",\n           
    \"m_TextSize\": 1,\n            \"m_Theme\": 1,\n            \"m_Position\":
    {\n                \"serializedVersion\": \"2\",\n                \"x\": 7534.0,\n               
    \"y\": 871.0,\n                \"width\": 656.0,\n                \"height\":
    336.00006103515627\n            },\n            \"m_GroupGuidSerialized\": \"00000000-0000-0000-0000-000000000000\"\n       
    },\n        {\n            \"m_GuidSerialized\": \"021584f8-5401-4762-be55-812cfa085d2d\",\n           
    \"m_Title\": \"Interactive Amplitude\",\n            \"m_Content\": \"Keep it
    ON for Bottled Liquids that are interactable.\\n\\nKeep it OFF for Tanks, Barrels
    etc.\",\n            \"m_TextSize\": 0,\n            \"m_Theme\": 1,\n           
    \"m_Position\": {\n                \"serializedVersion\": \"2\",\n               
    \"x\": 3291.0,\n                \"y\": 267.0,\n                \"width\": 262.0,\n               
    \"height\": 100.0\n            },\n            \"m_GroupGuidSerialized\": \"cdebf1be-4399-4b31-9ad4-8fb8bae01624\"\n       
    },\n        {\n            \"m_GuidSerialized\": \"316b8182-da13-425f-ad70-95461a1886f8\",\n           
    \"m_Title\": \"Biplanar Mapping for Bubbles\",\n            \"m_Content\": \"We
    discard the mapping for the XZ plane from triplanar mapping and just use XY and
    ZY mapping, to ensure bubbles are seen from all around the object.\",\n           
    \"m_TextSize\": 0,\n            \"m_Theme\": 1,\n            \"m_Position\":
    {\n                \"serializedVersion\": \"2\",\n                \"x\": 947.0,\n               
    \"y\": -676.0,\n                \"width\": 352.0,\n                \"height\":
    100.0\n            },\n            \"m_GroupGuidSerialized\": \"551c0bc5-43a8-4f46-b6b2-5600a9aca6d8\"\n       
    },\n        {\n            \"m_GuidSerialized\": \"3113f65f-1482-4022-aa96-eeb6af56e10b\",\n           
    \"m_Title\": \"Bubble upward movement\",\n            \"m_Content\": \"Offset
    the biplanar bubble UVs on V by time* bubble \\nspeed\",\n            \"m_TextSize\":
    0,\n            \"m_Theme\": 1,\n            \"m_Position\": {\n               
    \"serializedVersion\": \"2\",\n                \"x\": 1025.0,\n               
    \"y\": -34.0,\n                \"width\": 313.0,\n                \"height\":
    100.0\n            },\n            \"m_GroupGuidSerialized\": \"551c0bc5-43a8-4f46-b6b2-5600a9aca6d8\"\n       
    },\n        {\n            \"m_GuidSerialized\": \"968e0393-09b4-4eed-814d-970f4125909a\",\n           
    \"m_Title\": \"Surface ripples\",\n            \"m_Content\": \"Get a wavelike
    alpha cutoff based on voronoi noise. Replace voronoi noise with something else
    to get a different effect.\",\n            \"m_TextSize\": 0,\n            \"m_Theme\":
    1,\n            \"m_Position\": {\n                \"serializedVersion\": \"2\",\n               
    \"x\": 1747.0,\n                \"y\": 921.0,\n                \"width\": 200.0,\n               
    \"height\": 100.0\n            },\n            \"m_GroupGuidSerialized\": \"cc8caf3f-08c6-4ad6-a82e-f505b9495c8c\"\n       
    },\n        {\n            \"m_GuidSerialized\": \"21638874-373e-41a2-a2cd-8b39dd9d610c\",\n           
    \"m_Title\": \"IMPORTANT\",\n            \"m_Content\": \"1. When using for VR,
    use multi-pass rendering instead of multiview\\n2. Customize the shadergraoh
    as you have to, if you find it too expensive on mobile GPUs\\n3. Fill Levels
    are essentially offsets from object pivots, so Level 0 will put the liquid surface
    at where the pivot is.\",\n            \"m_TextSize\": 1,\n            \"m_Theme\":
    0,\n            \"m_Position\": {\n                \"serializedVersion\": \"2\",\n               
    \"x\": 7528.0,\n                \"y\": 395.0,\n                \"width\": 670.0,\n               
    \"height\": 364.11297607421877\n            },\n            \"m_GroupGuidSerialized\":
    \"00000000-0000-0000-0000-000000000000\"\n        },\n        {\n           
